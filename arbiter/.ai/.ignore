# Security Guardrails: Files the AI must NOT read

.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa
id_dsa
id_ecdsa
id_ed25519
node_modules/
vendor/
.venv/
venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
coverage/
*.log
*.sqlite
*.sqlite3
*.db

# Arbiter outputs and training corpora (large, generated)
arbiter-out/
arbiter-ab/
training/*/
*.egg-info/

# OmniEngineering graph viewer bundle (vendored JS, large)
.ai/graph-viewer/
