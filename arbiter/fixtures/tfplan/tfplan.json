              "provider_name": "registry.terraform.io/hashicorp/aws",
              "values": { "bucket": "acme-data-us", "acl": "public-read" }
            },
            {
              "address": "module.storage.aws_s3_bucket_server_side_encryption_configuration.data[\"eu\"]",
              "mode": "managed",
              "type": "aws_s3_bucket_server_side_encryption_configuration",
              "name": "data",
              "index": "eu",
              "provider_name": "registry.terraform.io/hashicorp/aws",
              "values": {
                "rule": [{ "apply_server_side_encryption_by_default": [{ "sse_algorithm": "aws:kms" }] }]
              }
            }
          ]
        }
      ]
    }
  },
  "resource_changes": [
    {
      "address": "aws_db_instance.primary",
      "mode": "managed",
      "type": "aws_db_instance",
      "name": "primary",
      "provider_name": "registry.terraform.io/hashicorp/aws",
      "change": {
        "actions": ["create"],
        "before": null,
        "after": {
