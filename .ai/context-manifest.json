    "./omni validate"
  ],
  "sync_command": "./omni sync",
  "fallback_contract_source": ".ai/entrypoints/fallback-contract.md",
  "context_retention_strategy": {
    "small_context_models": [
      "Read LLM_CONTEXT.md first.",
      "Read .ai/context-brief.md, .ai/project-configuration.md, .ai/project-map.md, and the active requirement.",
      "Read only the playbook, checklist, or rulepack relevant to the active task.",
      "Always read .ai/requirements/requirements.json before assigning or completing a requirement."
    ],
    "model_router_gateways": [
      "Do not assume the selected model has prior repository memory.",
      "Send LLM_CONTEXT.md or its distilled contents in the system/developer message.",
      "Include the active requirement ID, minimum access scope, and relevant rulepack summaries in each new routed session.",
      "If the router falls back to a different model, require the replacement model to reload the same manifest-driven context."
    ],
    "large_context_models": [
      "Start with the minimum or task-specific context profile before loading all files in required_read_order.",
      "Use .ai/.ignore to exclude sensitive or irrelevant paths.",
      "Use design/ for architecture and workflow context when changing project behavior."
    ]
  }
}
